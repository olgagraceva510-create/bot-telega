# Скопируйте в .env и подставьте значения (файл .env не коммитьте).

# Токен бота: @BotFather → /newbot или существующий бот
TELEGRAM_BOT_TOKEN=

# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Модель (по желанию)
OPENAI_MODEL=gpt-4o-mini

# Ваш Telegram username без @ — для кнопки «Связаться с Ольгой»
CONTACT_TELEGRAM_USERNAME=
